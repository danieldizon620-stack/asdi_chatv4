{
  "name": "asdi-ticketing",
  "version": "5.2.0",
  "private": true,
  "description": "ASDI_Ticketing chatroom-only Windows messenger with editable server settings",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ph.asdi.ticketing",
    "productName": "ASDI_Ticketing",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "settings-preload.js",
      "settings.html",
      "settings.js",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/asdi.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ASDI_Ticketing",
      "artifactName": "ASDI_Ticketing_Setup_${version}.${ext}"
    }
  }
}
