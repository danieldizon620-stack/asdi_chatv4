{
  "name":"asdi-messenger","version":"5.0.0","private":true,
  "description":"ASDI chatroom-only Windows messenger",
  "main":"main.js",
  "scripts":{"start":"electron .","dist":"electron-builder --win nsis"},
  "devDependencies":{"electron":"^33.4.11","electron-builder":"^25.1.8"},
  "build":{"appId":"ph.asdi.messenger","productName":"ASDI Messenger","asar":true,
    "files":["main.js","preload.js","assets/**","package.json"],
    "win":{"target":["nsis"],"icon":"assets/asdi.ico"},
    "nsis":{"oneClick":false,"allowToChangeInstallationDirectory":true,"createDesktopShortcut":true,"createStartMenuShortcut":true,"shortcutName":"ASDI Messenger","artifactName":"ASDI_Messenger_Setup_${version}.${ext}"}}
}
